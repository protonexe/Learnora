{
  "name": "learnora",
  "version": "1.0.0",
  "description": "Smart Education Platform with NFC Login and Device Lockdown for Android/iOS",
  "scripts": {
    "start": "npx cap run android",
    "build": "npx cap sync",
    "cap:init": "npx cap init Learnora com.learnora.app --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:update": "npx cap update",
    "android": "npx cap run android",
    "android:device": "npx cap run android --device",
    "android:emulator": "npx cap run android --target",
    "ios": "npx cap run ios",
    "ios:device": "npx cap run ios --device",
    "ios:simulator": "npx cap run ios --target",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "setup:kiosk": "bash setup-kiosk-android.sh",
    "web": "npx http-server -p 5500 -o"
  },
  "keywords": [
    "education",
    "learning",
    "mobile",
    "nfc",
    "kiosk",
    "android",
    "ios",
    "capacitor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "http-server": "^14.1.1",
    "typescript": "^5.9.3"
  }
}
